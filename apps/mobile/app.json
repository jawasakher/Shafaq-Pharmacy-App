{
  "expo": {
    "name": "شَفَق",
    "slug": "shafaq",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/branding/shafaq-icon-1024.png",
    "scheme": "shafaq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/shafaq-icon-1024.png"
    },
    "android": {
      "package": "com.shafaq.mobile",
      "versionCode": 7,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/branding/shafaq-emblem.png",
        "monochromeImage": "./assets/branding/shafaq-emblem-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/c43e6a12-974a-4872-bc4c-f1eb5f0c8372",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4FCFE",
          "image": "./assets/branding/shafaq-splash-logo.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c43e6a12-974a-4872-bc4c-f1eb5f0c8372"
      }
    }
  }
}
